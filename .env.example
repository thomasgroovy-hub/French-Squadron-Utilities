DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Roblox integration: MySQL database provided by your host.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Roblox integration: shared secret sent by Roblox in the Authorization header.
# Use the same value as the Roblox Creator secret named PERMADEATH_BOT_API_KEY.
ROBLOX_EVENT_SECRET=

# HTTP port for the death webhook. The stable HTTPS relay must forward to this port.
PORT=8108
