DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Roblox integration: MySQL database provided by your host.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Roblox integration: shared secret sent by Roblox in the Authorization header.
ROBLOX_EVENT_SECRET=

# HTTP port for the death webhook. Set this to 8108 on your host.
PORT=8080
