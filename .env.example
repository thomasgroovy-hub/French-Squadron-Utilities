DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# Voice channel whose human members drive the bot's profile activity/status.
# Defaults to the squadron's activity channel when unset.
VOICE_ACTIVITY_CHANNEL_ID=

# Placeholder shown while nobody is in the trigger voice channel. It rotates
# through three built-in texts every VOICE_ACTIVITY_ROTATE_MS (5 min by
# default). Set VOICE_ACTIVITY_DEFAULT_NAME to pin a single fixed text instead.
VOICE_ACTIVITY_DEFAULT_NAME=
VOICE_ACTIVITY_ROTATE_MS=

# Rich presence (RPC) image. It must be uploaded to the application's Rich
# Presence assets in the Discord Developer Portal.
# Default image: 182D7D51-2F44-477A-8505-AC972CF2E8ED.
VOICE_ACTIVITY_RPC_IMAGE=
VOICE_ACTIVITY_RPC_LARGE_TEXT=
VOICE_ACTIVITY_RPC_STATE=

# How often the displayed duration is refreshed, in milliseconds.
# Defaults to 60000 (1 minute).
VOICE_ACTIVITY_REFRESH_MS=

# Channel where strike changes made on the companion site are logged.
# The bot needs "Send Messages" here. Defaults to the committee channel when
# unset, so this is only needed to move the log elsewhere.
STRIKE_LOG_CHANNEL_ID=

# MySQL database provided by your host.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Companion site database. The site runs on a different MySQL server and cannot
# read this one, so Roblox links are mirrored into its `roblox_links` table.
# Leave these empty to run the bot without mirroring. Prefer a MySQL user
# restricted to that single database.
SITE_MYSQL_HOST=
SITE_MYSQL_PORT=3306
SITE_MYSQL_USER=
SITE_MYSQL_PASSWORD=
SITE_MYSQL_DATABASE=
