DISCORD_TOKEN=
DISCORD_APPLICATION_ID=

# MySQL database provided by your host.
MYSQL_HOST=
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=

# Companion site database. The site runs on a different MySQL server and cannot
# read this one, so Roblox links are mirrored into its `roblox_links` table.
# Leave these empty to run the bot without mirroring. Prefer a MySQL user
# restricted to that single database.
SITE_MYSQL_HOST=
SITE_MYSQL_PORT=3306
SITE_MYSQL_USER=
SITE_MYSQL_PASSWORD=
SITE_MYSQL_DATABASE=
